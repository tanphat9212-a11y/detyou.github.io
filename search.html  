<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kết quả tìm kiếm - ShopVN</title>
  <link rel="stylesheet" href="assets/css/style.css"/>
  <style>
    /* Bổ sung một số CSS để trang kết quả hiển thị lưới rộng rãi giống Shopee */
    .search-result-container { max-width: 1200px; margin: 30px auto; padding: 0 15px; }
    .result-title { font-size: 18px; margin-bottom: 20px; color: #555; }
    .keyword-highlight { color: #ee4d2d; font-weight: bold; }
    .no-result { grid-column: 1/-1; text-align: center; color: #999; padding: 50px 0; font-size: 16px; }
  </style>
</head>
<body>

<header class="header">
  <div class="logo" onclick="window.location.href='index.html'" style="cursor:pointer;">ShopVN</div>

  <div class="search">
    <input type="text" id="main-search-input" placeholder="Tìm sản phẩm khác..." />
    <button id="main-search-btn">🔍</button>
  </div>

  <div class="cart">🛒 Giỏ hàng</div>
</header>

<nav class="nav">
  <a href="index.html">Trang chủ</a>
  <a href="#">Thời trang</a>
  <a href="#">Giày dép</a>
  <a href="#">Điện tử</a>
  <a href="#">Phụ kiện</a>
</nav>

<div class="search-result-container">
  <div class="result-title">Kết quả tìm kiếm cho từ khóa: <span id="keywordDisplay" class="keyword-highlight">"..."</span></div>
  
  <div class="grid" id="searchResultGrid"></div>
</div>

<footer class="footer">
  © 2026 ShopVN - Kết quả lọc tìm kiếm nâng cao
</footer>

<script type="module">
// Lấy dữ liệu sản phẩm từ file gốc của bạn
import products from "./data/products.js";

const grid = document.getElementById("searchResultGrid");
const keywordDisplay = document.getElementById("keywordDisplay");
const searchInput = document.getElementById("main-search-input");
const searchBtn = document.getElementById("main-search-btn");

// 1. Đọc từ khóa từ URL (?q=...) xuống và thực hiện lọc
function getQueryParam() {
  const urlParams = new URLSearchParams(window.location.search);
  return urlParams.get('q') || "";
}

function processSearch() {
  const keyword = getQueryParam();
  keywordDisplay.innerText = `"${keyword}"`;
  searchInput.value = keyword; // Đồng bộ chữ vừa tìm lên thanh tìm kiếm lớn

  if (!grid) return;
  grid.innerHTML = "";

  // Tiến hành lọc sản phẩm
  const matchedProducts = products.filter(p => 
    p.name.toLowerCase().includes(keyword.toLowerCase())
  );

  if (matchedProducts.length === 0) {
    grid.innerHTML = `<div class="no-result">Không tìm thấy sản phẩm nào phù hợp với từ khóa của bạn.</div>`;
    return;
  }

  // Đổ sản phẩm tìm kiếm được ra màn hình
  matchedProducts.forEach(p => {
    const div = document.createElement("div");
    div.className = "card";
    div.innerHTML = `
      <img src="${p.images ? p.images[0] : 'https://via.placeholder.com/300'}"/>
      <div class="card-body">
        <div class="card-title">${p.name}</div>
        <div class="price">${p.price.toLocaleString()}₫</div>
        <button class="btn" onclick="location.href='product-detail.html?id=${p.id}'">Xem</button>
      </div>
    `;
    grid.appendChild(div);
  });
}

// Chạy hàm lọc ngay khi trang search.html được tải xong
processSearch();

// 2. Cho phép người dùng gõ tiếp từ khóa mới và tìm kiếm ngay tại trang kết quả này
function reSearch() {
  const newKeyword = searchInput.value.trim();
  if (newKeyword !== "") {
    window.location.href = "search.html?q=" + encodeURIComponent(newKeyword);
  }
}

searchBtn.addEventListener("click", reSearch);
searchInput.addEventListener("keypress", (e) => {
  if (e.key === "Enter") reSearch();
});
</script>

</body>
</html>