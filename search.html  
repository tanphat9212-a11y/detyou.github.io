<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kết quả tìm kiếm - ShopVN</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <style>
    /* Giao diện đồng bộ phong cách Shopee */
    :root {
      --primary-color: #ee4d2d;
      --bg-color: #f5f5f5;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Roboto', sans-serif; }
    body { background-color: var(--bg-color); color: #333; }
    
    .header {
      background: linear-gradient(-180deg, #f53d2d, #f63);
      padding: 15px 10%;
      display: flex;
      align-items: center;
      gap: 30px;
      position: sticky;
      top: 0; z-index: 100;
    }
    .logo { font-size: 26px; font-weight: bold; color: white; text-decoration: none; }
    
    .search-container { flex: 0 1 600px; display: flex; background: white; border-radius: 4px; padding: 3px; }
    .search-container input { flex: 1; border: none; padding: 10px 15px; outline: none; font-size: 14px; }
    .search-container button { background: var(--primary-color); border: none; color: white; padding: 0 25px; cursor: pointer; border-radius: 3px; }

    .container { max-width: 1200px; margin: 30px auto; padding: 0 15px; }
    .search-title { font-size: 18px; margin-bottom: 20px; color: #555; }
    .search-keyword { color: var(--primary-color); font-weight: bold; }

    /* Lưới sản phẩm hiển thị nhiều và rộng rãi hơn */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; }
    
    .card { background: white; border-radius: 4px; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.1); transition: all 0.2s; position: relative; cursor: pointer; display: flex; flex-direction: column; }
    .card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.15); border: 1px solid var(--primary-color); }
    .card img { width: 100%; height: 180px; object-fit: cover; }
    .card-body { padding: 12px; display: flex; flex-direction: column; flex-grow: 1; }
    .card-title { font-size: 13px; line-height: 18px; height: 36px; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; margin-bottom: 8px; }
    .price { color: var(--primary-color); font-size: 16px; font-weight: 500; }
    .discount-badge { position: absolute; top: 0; right: 0; background: rgba(255,212,36,.9); color: var(--primary-color); font-size: 12px; font-weight: 600; padding: 3px 5px; border-bottom-left-radius: 4px; }
    .rating-sales { font-size: 11px; color: #757575; margin-top: auto; display: flex; justify-content: space-between; padding-top: 8px; }
    
    .footer { text-align: center; padding: 30px 0; color: #888; font-size: 14px; margin-top: 50px; background: white; border-top: 3px solid var(--primary-color); }
  </style>
</head>
<body>

<header class="header">
  <a href="index.html" class="logo">ShopVN</a>
  <div class="search-container">
    <input type="text" id="pageSearchInput" placeholder="Tìm sản phẩm khác..." />
    <button id="pageSearchBtn">🔍</button>
  </div>
</header>

<div class="container">
  <div class="search-title">Kết quả tìm kiếm cho từ khóa: <span id="keywordDisplay" class="search-keyword">"..."</span></div>
  <div class="grid" id="searchResultGrid"></div>
</div>

<footer class="footer">
  © 2026 ShopVN - Trang Tìm Kiếm Sản Phẩm Chuyên Nghiệp
</footer>

<script type="module">
  // Kho dữ liệu tổng để tìm kiếm (Bạn có thể kết nối với file data/products.js của bạn)
  const allProducts = [
    { id: "ao-1", name: "Áo thun basic Cotton 100% thoáng mát nhiều màu", price: 140000, image: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=500&auto=format&fit=crop&q=60" },
    { id: "phone-1", name: "Điện thoại thông minh iPhone 15 Pro Max 256GB Chính hãng", price: 25500000, image: "https://images.unsplash.com/photo-1510557880182-3d4d3cba35a5?w=500&auto=format&fit=crop&q=60" },
    { id: "giay-1", name: "Giày Sneaker Thể Thao Nam Nữ Cổ Thấp Đi Học Cực Êm", price: 720000, image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500&auto=format&fit=crop&q=60" },
    { id: "balo-1", name: "Balo Thời Trang Nam Nữ Chống Nước Có Ngăn Laptop", price: 350000, image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500&auto=format&fit=crop&q=60" }
  ];

  const grid = document.getElementById("searchResultGrid");
  const keywordDisplay = document.getElementById("keywordDisplay");
  const pageSearchInput = document.getElementById("pageSearchInput");
  const pageSearchBtn = document.getElementById("pageSearchBtn");

  // Hàm lấy từ khóa "q=" từ URL xuống
  function getQueryKeyword() {
    const urlParams = new URLSearchParams(window.location.search);
    return urlParams.get('q') || "";
  }

  // Hàm xử lý tìm kiếm và hiển thị kết quả lên lưới
  function doSearch() {
    const keyword = getQueryKeyword();
    keywordDisplay.innerText = `"${keyword}"`;
    pageSearchInput.value = keyword;

    grid.innerHTML = "";
    
    // Lọc sản phẩm trùng từ khóa
    const results = allProducts.filter(p => p.name.toLowerCase().includes(keyword.toLowerCase()));

    if(results.length === 0) {
      grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; color:#999; padding:50px;">Không tìm thấy sản phẩm nào!</div>`;
      return;
    }

    results.forEach(p => {
      const div = document.createElement("div");
      div.className = "card";
      div.onclick = () => window.location.href = `product-detail.html?id=${p.id}`;
      div.innerHTML = `
        <div class="discount-badge">-20%</div>
        <img src="${p.image}" onerror="this.src='https://via.placeholder.com/300'">
        <div class="card-body">
          <div class="card-title">${p.name}</div>
          <div class="price">${p.price.toLocaleString()}₫</div>
          <div class="rating-sales"><span>⭐ 4.8</span><span>Đã bán 100+</span></div>
        </div>
      `;
      grid.appendChild(div);
    });
  }

  // Thực hiện tìm kiếm ngay khi tải trang xong
  doSearch();

  // Cho phép người dùng tìm kiếm tiếp tục ngay tại trang này
  function reSearch() {
    const newKeyword = pageSearchInput.value.trim();
    if(newKeyword !== "") {
      const currentPath = window.location.pathname.substring(0, window.location.pathname.lastIndexOf('/') + 1);
      window.location.href = window.location.origin + currentPath + "search.html?q=" + encodeURIComponent(newKeyword);
    }
  }
  pageSearchBtn.addEventListener("click", reSearch);
  pageSearchInput.addEventListener("keypress", (e) => { if(e.key === "Enter") reSearch(); });
</script>
</body>
</html>