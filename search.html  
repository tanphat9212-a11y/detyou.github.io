}

.image{
height:220px;
overflow:hidden;
}

.image img{
height:100%;
object-fit:cover;
transition:.4s;
}

.card:hover img{
transform:scale(1.08);
}

.info{
padding:16px;
}

.name{
height:48px;
font-size:16px;
font-weight:700;
overflow:hidden;
