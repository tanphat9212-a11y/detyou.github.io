:root{
  --primary:#3b82f6;
  --primary-dark:#1d4ed8;
  --bg:#f1f5f9;
  --card:#ffffff;
  --text:#0f172a;
  --muted:#64748b;
  --shadow:0 10px 30px rgba(0,0,0,0.08);
  --radius:16px;
}

/* RESET */
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:'Poppins', sans-serif;
  background:var(--bg);
  color:var(--text);
}

/* ===== HEADER LEVEL 2 ===== */
header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:15px 60px;
  background:rgba(255,255,255,0.8);
  backdrop-filter:blur(10px);
  position:sticky;
  top:0;
  z-index:1000;
  box-shadow:0 2px 20px rgba(0,0,0,0.05);
}

header h1{
  color:var(--primary);
  font-weight:800;
  letter-spacing:1px;
}

nav a{
  margin:0 12px;
  text-decoration:none;
  color:var(--text);
  font-weight:500;
  transition:0.2s;
}

nav a:hover{
  color:var(--primary);
}

/* ===== HERO LEVEL 2 ===== */
.hero{
  height:460px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  color:white;
  background:linear-gradient(135deg,#3b82f6,#1d4ed8);
  position:relative;
  overflow:hidden;
}

.hero::after{
  content:'';
  position:absolute;
  width:600px;
  height:600px;
  background:rgba(255,255,255,0.1);
  border-radius:50%;
  top:-200px;
  right:-200px;
}

.hero h2{
  font-size:48px;
  font-weight:800;
  z-index:2;
}

.hero p{
  margin-top:10px;
  font-size:18px;
  opacity:0.9;
  z-index:2;
}

.hero button{
  margin-top:20px;
  padding:12px 26px;
  border:none;
  border-radius:12px;
  background:white;
  color:var(--primary);
  font-weight:600;
  cursor:pointer;
  z-index:2;
  transition:0.3s;
}

.hero button:hover{
  transform:scale(1.05);
}

/* ===== FLASH SALE LEVEL 2 ===== */
.flash-sale{
  width:90%;
  margin:30px auto;
  padding:18px;
  border-radius:var(--radius);
  background:linear-gradient(90deg,#0f172a,#1e293b);
  color:white;
  display:flex;
  justify-content:space-between;
  align-items:center;
  box-shadow:var(--shadow);
}

/* ===== PRODUCTS GRID LEVEL 2 ===== */
.products{
  width:90%;
  margin:30px auto;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:22px;
}

/* ===== PRODUCT CARD LEVEL 2 ===== */
.product-card{
  background:var(--card);
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:var(--shadow);
  transition:0.3s;
  position:relative;
}

.product-card:hover{
  transform:translateY(-10px);
}

.product-card img{
  width:100%;
  height:230px;
  object-fit:cover;
}

/* BADGE HOT / SALE */
.badge{
  position:absolute;
  top:10px;
  left:10px;
  background:#ef4444;
  color:white;
  padding:5px 10px;
  font-size:12px;
  border-radius:20px;
}

/* CONTENT */
.product-card h3{
  padding:10px 12px 0;
  font-size:15px;
}

.price{
  padding:5px 12px;
  display:flex;
  gap:10px;
  align-items:center;
}

.price span{
  color:var(--primary);
  font-weight:700;
}

.price del{
  color:var(--muted);
  font-size:13px;
}

/* BUTTON LEVEL 2 */
.product-card button{
  width:90%;
  margin:10px auto 15px;
  display:block;
  padding:10px;
  border:none;
  border-radius:10px;
  background:var(--primary);
  color:white;
  font-weight:600;
  cursor:pointer;
  transition:0.25s;
}

.product-card button:hover{
  background:var(--primary-dark);
  transform:scale(1.03);
}

/* ===== FOOTER ===== */
footer{
  margin-top:40px;
  background:#0f172a;
  color:white;
  text-align:center;
  padding:30px;
}

/* ===== TOAST LEVEL 2 ===== */
.toast{
  position:fixed;
  bottom:20px;
  right:20px;
  background:#0f172a;
  color:white;
  padding:12px 18px;
  border-radius:10px;
  opacity:0;
  transform:translateY(20px);
  transition:0.3s;
}

.toast.show{
  opacity:1;
  transform:translateY(0);
}
.cart-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,0.4);
  opacity:0;
  visibility:hidden;
  transition:0.3s;
  z-index:999;
}

.cart-drawer{
  position:fixed;
  top:0;
  right:-400px;
  width:380px;
  height:100%;
  background:#fff;
  box-shadow:-10px 0 30px rgba(0,0,0,0.1);
  transition:0.3s;
  z-index:1000;
  display:flex;
  flex-direction:column;
}

.cart-drawer.open{
  right:0;
}

.cart-overlay.show{
  opacity:1;
  visibility:visible;
}

.cart-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:15px;
  border-bottom:1px solid #eee;
}

.cart-header button{
  border:none;
  background:none;
  font-size:18px;
  cursor:pointer;
}

.cart-items{
  flex:1;
  overflow:auto;
  padding:10px;
}

.cart-item{
  display:flex;
  gap:10px;
  padding:10px;
  border-bottom:1px solid #eee;
}

.cart-item img{
  width:60px;
  height:60px;
  object-fit:cover;
  border-radius:8px;
}

.cart-footer{
  padding:15px;
  border-top:1px solid #eee;
}

.checkout-btn{
  width:100%;
  padding:12px;
  background:#3b82f6;
  color:white;
  border:none;
  border-radius:10px;
  cursor:pointer;
}
/* HEART WISHLIST */
.heart{
  position:absolute;
  top:10px;
  right:10px;
  cursor:pointer;
  font-size:18px;
  opacity:0.5;
  transition:0.2s;
}

.heart.active{
  opacity:1;
  transform:scale(1.2);
}

/* CART COUNT BADGE */
.cart-btn{
  position:relative;
}

.cart-count{
  position:absolute;
  top:-8px;
  right:-8px;
  background:red;
  color:white;
  font-size:12px;
  width:18px;
  height:18px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
}

/* CART ITEM PRO */
.cart-item{
  display:flex;
  gap:10px;
  margin-bottom:10px;
  padding:10px;
  border-radius:10px;
  background:#f8fafc;
}

.qty button{
  padding:2px 8px;
  margin:0 4px;
}

/* ANIMATION */
.product-card{
  animation:fadeIn .3s ease;
}

@keyframes fadeIn{
  from{opacity:0; transform:translateY(10px);}
  to{opacity:1; transform:translateY(0);}
}

/* CONTROL BAR */
.controls{
  width:90%;
  margin:20px auto;
  display:flex;
  gap:10px;
}

.controls select,
.controls input{
  padding:10px;
  border-radius:10px;
  border:1px solid #ddd;
  outline:none;
}

/* SKELETON LOADING */
.skeleton-card{
  height:300px;
  background:linear-gradient(90deg,#eee,#f5f5f5,#eee);
  background-size:200% 100%;
  animation:loading 1.2s infinite;
  border-radius:12px;
}

@keyframes loading{
  0%{background-position:200% 0;}
  100%{background-position:-200% 0;}
}

/* HOVER PRO */
.product-card:hover{
  transform:translateY(-12px) scale(1.02);
  box-shadow:0 20px 40px rgba(0,0,0,0.1);
}
const orders = JSON.parse(localStorage.getItem("orders")) || [];

function saveOrder(order){
  orders.push(order);
  localStorage.setItem("orders", JSON.stringify(orders));
}