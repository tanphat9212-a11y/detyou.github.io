/* ==========================================================================
   LAYOUT — grid & khung dùng chung
   ========================================================================== */

.grid {
  display: grid;
  gap: var(--space-5);
}

.grid-categories {
  grid-template-columns: repeat(6, 1fr);
}

.grid-products {
  grid-template-columns: repeat(4, 1fr);
}

.grid-2 {
  grid-template-columns: 1fr 1fr;
  align-items: center;
}

.grid-footer {
  grid-template-columns: 2fr 1fr 1fr 1fr 1.4fr;
  gap: var(--space-6);
}

@media (max-width: 1100px) {
  .grid-categories { grid-template-columns: repeat(4, 1fr); }
  .grid-products { grid-template-columns: repeat(3, 1fr); }
  .grid-footer { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 720px) {
  .grid-categories { grid-template-columns: repeat(3, 1fr); }
  .grid-products { grid-template-columns: repeat(2, 1fr); }
  .grid-2 { grid-template-columns: 1fr; }
  .grid-footer { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 460px) {
  .grid-categories { grid-template-columns: repeat(2, 1fr); }
  .grid-products { grid-template-columns: 1fr 1fr; }
}