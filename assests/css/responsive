/* ==========================================================================
   RESPONSIVE — điều chỉnh tổng thể theo breakpoint
   ========================================================================== */

/* Laptop nhỏ / Tablet ngang */
@media (max-width: 1100px) {
  .container { padding-inline: var(--space-4); }
  .section { padding-block: var(--space-7); }
}

/* Tablet dọc */
@media (max-width: 860px) {
  .header-inner { gap: var(--space-3); }
  .logo span.logo-text { display: none; }
  .hero-trust { flex-wrap: wrap; gap: var(--space-4); }
}

/* Mobile */
@media (max-width: 640px) {
  .topbar { display: none; }
  .site-header { height: 64px; }
  :root { --header-height: 64px; }
  .section { padding-block: var(--space-6); }
  .section-head { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .tabs { overflow-x: auto; width: 100%; }
  .newsletter { padding: var(--space-5); }
  .cart-drawer { width: 100%; }
}
.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}