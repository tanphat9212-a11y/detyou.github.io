<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Roboto',sans-serif;
}

body{
background:#f5f5f5;
color:#333;
}

a{
text-decoration:none;
color:inherit;
}

img{
width:100%;
display:block;
}

header{
background:#ee4d2d;
padding:16px 0;
color:#fff;
position:sticky;
top:0;
z-index:999;
box-shadow:0 3px 10px rgba(0,0,0,.15);
}

.header{
width:1200px;
max-width:95%;
margin:auto;
display:flex;
justify-content:space-between;
align-items:center;
}

.logo{
font-size:34px;
font-weight:900;
letter-spacing:1px;
}

.search{
width:520px;
display:flex;
background:#fff;
border-radius:5px;
overflow:hidden;
}

.search input{
flex:1;
border:none;
padding:13px 15px;
outline:none;
font-size:15px;
}

.search button{
border:none;
background:#fb5533;
color:#fff;
padding:0 25px;
cursor:pointer;
font-size:18px;
}

.icons{
display:flex;
gap:25px;
font-weight:500;
}

.banner{
width:1200px;
max-width:95%;
margin:25px auto;
height:230px;
border-radius:14px;
overflow:hidden;
background:linear-gradient(135deg,#ff6a00,#ffb347);
display:flex;
align-items:center;
justify-content:center;
color:#fff;
font-size:42px;
font-weight:900;
box-shadow:0 10px 25px rgba(0,0,0,.12);
}

.container{
width:1200px;
max-width:95%;
margin:auto;
display:grid;
grid-template-columns:260px 1fr;
gap:25px;
}

.sidebar{
background:#fff;
padding:22px;
border-radius:12px;
box-shadow:0 4px 15px rgba(0,0,0,.08);
height:max-content;
}

.sidebar h2{
font-size:22px;
margin-bottom:20px;
}

.sidebar ul{
list-style:none;
}

.sidebar li{
padding:13px;
border-radius:8px;
margin-bottom:8px;
cursor:pointer;
transition:.3s;
font-weight:500;
}

.sidebar li:hover,
.sidebar li.active{
background:#fff1ed;
color:#ee4d2d;
}

.content{
display:flex;
flex-direction:column;
gap:20px;
}

.toolbar{
background:#fff;
padding:18px 22px;
border-radius:12px;
display:flex;
justify-content:space-between;
align-items:center;
box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.toolbar select{
padding:10px 15px;
border:1px solid #ddd;
border-radius:6px;
outline:none;
}

.products{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
}

.card{
background:#fff;
border-radius:12px;
overflow:hidden;
transition:.3s;
box-shadow:0 5px 15px rgba(0,0,0,.08);
}

.card:hover{
transform:translateY(-8px);
box-shadow:0 12px 28px rgba(0,0,0,.15);
}

.thumb{
height:220px;
overflow:hidden;
}

.thumb img{
height:100%;
object-fit:cover;
transition:.4s;
}

.card:hover img{
transform:scale(1.08);
}

.info{
padding:16px;
}

.name{
font-size:16px;
font-weight:700;
height:48px;
overflow:hidden;
}

.price{
margin-top:12px;
font-size:24px;
font-weight:900;
color:#ee4d2d;
}

.old{
font-size:15px;
color:#999;
text-decoration:line-through;
margin-left:8px;
}

.bottom{
margin-top:14px;
display:flex;
justify-content:space-between;
align-items:center;
}

.star{
color:#ffb400;
font-size:14px;
}

.sold{
font-size:13px;
color:#888;
}

.btn{
margin-top:18px;
display:block;
text-align:center;
padding:12px;
background:#ee4d2d;
color:#fff;
border-radius:8px;
font-weight:700;
transition:.3s;
}

.btn:hover{
background:#d84324;
}

.pagination{
margin:40px 0 60px;
display:flex;
justify-content:center;
gap:10px;
}

.pagination a{
width:42px;
height:42px;
display:flex;
align-items:center;
justify-content:center;
background:#fff;
border-radius:8px;
font-weight:700;
box-shadow:0 3px 10px rgba(0,0,0,.08);
transition:.3s;
}

.pagination a:hover,
.pagination a.active{
background:#ee4d2d;
color:#fff;
}

footer{
margin-top:30px;
background:#fff;
padding:40px;
text-align:center;
color:#777;
}

@media(max-width:1100px){

.container{
grid-template-columns:1fr;
}

.products{
grid-template-columns:repeat(2,1fr);
}

.search{
display:none;
}

}

@media(max-width:650px){

.products{
grid-template-columns:1fr;
}

.banner{
font-size:28px;
height:170px;
}

.toolbar{
flex-direction:column;
gap:15px;
align-items:flex-start;
}

}

</style>

</head>

