<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Giỏ hàng | SHOPVN</title>

<link rel="icon" href="assets/images/logo/favicon.ico">
<link rel="stylesheet" href="assets/css/style.css">
<link rel="stylesheet" href="assets/css/cart.css">
<link rel="link rel" href="assets/css/responsive.css">

<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Roboto',sans-serif;
}

body{
background:#f5f5f5;
color:#333;
}

a{
text-decoration:none;
color:inherit;
}

img{
display:block;
width:100%;
}

header{
background:#ee4d2d;
color:#fff;
padding:18px 0;
box-shadow:0 3px 10px rgba(0,0,0,.15);
}

.header{
width:1200px;
max-width:95%;
margin:auto;
display:flex;
justify-content:space-between;
align-items:center;
}

.logo{
font-size:34px;
font-weight:900;
letter-spacing:1px;
}

.header-right{
display:flex;
gap:30px;
font-size:16px;
font-weight:500;
}

.container{
width:1200px;
max-width:95%;
margin:35px auto;
display:grid;
grid-template-columns:2fr 1fr;
gap:25px;
align-items:start;
}

.cart{
background:#fff;
border-radius:12px;
overflow:hidden;
box-shadow:0 5px 20px rgba(0,0,0,.06);
}

.cart-title{
padding:22px;
font-size:24px;
font-weight:700;
border-bottom:1px solid #eee;
}

.item{
display:grid;
grid-template-columns:120px 1fr 150px 140px 120px 60px;
gap:15px;
align-items:center;
padding:20px;
border-bottom:1px solid #eee;
}

.item img{
height:110px;
object-fit:cover;
border-radius:10px;
}

.name{
font-size:18px;
font-weight:700;
margin-bottom:8px;
}

.variant{
color:#777;
font-size:14px;
}

.price{
font-size:20px;
font-weight:700;
color:#ee4d2d;
}

.qty{
display:flex;
justify-content:center;
align-items:center;
}

.qty button{
width:34px;
height:34px;
border:none;
background:#f1f1f1;
font-size:18px;
cursor:pointer;
}

.qty input{
width:48px;
height:34px;
border:1px solid #ddd;
text-align:center;
font-size:16px;
}

.total{
font-size:20px;
font-weight:700;
color:#ee4d2d;
}

.remove{
font-size:24px;
cursor:pointer;
color:#888;
transition:.3s;
}

.remove:hover{
color:red;
}

.summary{
background:#fff;
border-radius:12px;
padding:25px;
box-shadow:0 5px 20px rgba(0,0,0,.06);
position:sticky;
top:20px;
}

.summary h2{
margin-bottom:25px;
}

.row{
display:flex;
justify-content:space-between;
margin:16px 0;
font-size:16px;
}

.total-price{
font-size:28px;
font-weight:900;
color:#ee4d2d;
margin:25px 0;
display:flex;
justify-content:space-between;
}

button.checkout{
width:100%;
padding:16px;
border:none;
background:#ee4d2d;
color:#fff;
font-size:18px;
font-weight:700;
border-radius:8px;
cursor:pointer;
transition:.3s;
}

button.checkout:hover{
background:#d93f21;
}

button.continue{
margin-top:15px;
width:100%;
padding:15px;
border:2px solid #ee4d2d;
background:#fff;
color:#ee4d2d;
font-size:17px;
font-weight:700;
border-radius:8px;
cursor:pointer;
transition:.3s;
}

button.continue:hover{
background:#fff2ef;
}

footer{
margin-top:60px;
background:#fff;
padding:35px;
text-align:center;
color:#888;
font-size:15px;
}

@media(max-width:1000px){

.container{
grid-template-columns:1fr;
}

.item{
grid-template-columns:100px 1fr;
}

.price,
.qty,
.total,
.remove{
margin-top:12px;
}

.item{
display:block;
}

.item img{
width:100px;
margin-bottom:15px;
}

.qty{
justify-content:flex-start;
}

}

</style>

</head>

